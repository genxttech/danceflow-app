# BILLING-QA price verifier (scripts/qa/billing-price-verify.ts) -- Stripe TEST mode only.
# Copy to .env.billing-qa.local (git-ignored), fill in, then:
#   npm run qa:billing-prices -- --env-file .env.billing-qa.local
# See docs/qa/billing-qa.md.

# Stripe TEST key for the sandbox account that holds these Prices. A restricted key with
# only "Prices: Read" is enough (rk_test_...). Live keys are refused. Never STRIPE_SECRET_KEY.
BILLING_QA_STRIPE_TEST_KEY=

# The same variable names the app reads. Use TEST-mode Price IDs only.
STRIPE_PRICE_STUDIO_STARTER_FOUNDER=
STRIPE_PRICE_STUDIO_GROWTH_FOUNDER=
STRIPE_PRICE_STUDIO_PRO_FOUNDER=

# Optional: Regular (STANDARD) Prices are verified whenever set, even before activation.
# STRIPE_PRICE_STUDIO_STARTER_STANDARD=
# STRIPE_PRICE_STUDIO_GROWTH_STANDARD=
# STRIPE_PRICE_STUDIO_PRO_STANDARD=

# Optional: grandfathered Prices, comma-separated.
# STRIPE_PRICE_STUDIO_PRO_FOUNDER_LEGACY=

# Flags, same semantics as the app (unset Founder flag = active; Regular needs both).
# FOUNDER_PRICING_ACTIVE=
# NEXT_PUBLIC_FOUNDER_PRICING_ACTIVE=
# REGULAR_PRICING_ACTIVATED=
# REGULAR_PRICING_APPROVAL_REF=
