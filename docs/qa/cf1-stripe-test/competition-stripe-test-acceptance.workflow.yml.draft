name: Competition Stripe TEST acceptance

# DRAFT, NOT UNDER .github/, UNVALIDATED (never run, not dry-run, action SHAs and pins are TODO). See STRIPE_TEST_ACCEPTANCE_PACKAGE.md.
# Moving this file to .github/workflows/ on release/website-embeds requires: the environment `competition-stripe-test` to exist first
# (owner = only reviewer, admin bypass OFF, deployment branch = release/website-embeds), CODEOWNERS review, and every TODO below resolved.
# Trigger: workflow_dispatch ONLY. Never pull_request / push / schedule.
run-name: Competition Stripe TEST acceptance @ ${{ github.sha }}

on:
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: competition-stripe-test-acceptance
  cancel-in-progress: false

defaults:
  run:
    shell: /usr/bin/bash --noprofile --norc -euo pipefail {0}

jobs:
  acceptance:
    name: Competition Stripe TEST acceptance (owner-approved)
    if: github.event_name == 'workflow_dispatch' && github.repository == 'genxttech/danceflow-app' && github.ref == 'refs/heads/release/website-embeds'
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    environment: competition-stripe-test
    env:
      BASH_ENV: ""
      ENV: ""
      # TEST ids (not credentials). The guard refuses PLACEHOLDER values.
      CF1_EXPECT_PLATFORM_ACCT: "acct_1UZ320IPJs53nwt7"
      CF1_EXPECT_CONNECTED_ACCT: "acct_1UZibNRCFiaIzL1V"
      CF1_STRIPE_CALL_CAP: "600"
      # TODO pins reviewed under code-owner approval: package.json, package-lock.json, tsconfig.json, the e2e tree, the relay script, the evidence tooling.
      CF1_PIN_E2E_TREE: "TODO_PLACEHOLDER"
      CF1_PIN_PACKAGE_LOCK_SHA256: "TODO_PLACEHOLDER"
      CF1_PIN_RELAY_SHA256: "TODO_PLACEHOLDER"
      D24_EVIDENCE_PUBLIC_KEY: scripts/qa/d24-gh-proof/evidence-public-key.pem
    steps:
      - name: Commit under approval
        env: { SHA: "${{ github.sha }}", ACTOR: "${{ github.actor }}", RUN_ID: "${{ github.run_id }}", WF: "${{ github.workflow_ref }}" }
        run: |
          { echo "## Competition Stripe TEST acceptance - what was approved"; echo "- workflow: \`$WF\`"; echo "- commit: \`$SHA\`"; echo "- dispatched by: $ACTOR"; echo "- run id: $RUN_ID"; } >> "$GITHUB_STEP_SUMMARY"

      - name: Guards (fail closed, no key used)
        run: |
          case "$CF1_EXPECT_PLATFORM_ACCT$CF1_EXPECT_CONNECTED_ACCT$CF1_PIN_E2E_TREE$CF1_PIN_PACKAGE_LOCK_SHA256$CF1_PIN_RELAY_SHA256" in *PLACEHOLDER*) echo "FAIL: placeholders remain"; exit 1;; esac
          [ "$GITHUB_REF" = "refs/heads/release/website-embeds" ] || { echo "FAIL: wrong ref"; exit 1; }

      - name: Fetch exactly the dispatched commit; it must still be the branch tip; verify pins (plain git, no node yet)
        env: { SHA: "${{ github.sha }}" }
        run: |
          git init -q "$GITHUB_WORKSPACE" && cd "$GITHUB_WORKSPACE"
          git remote add origin "https://github.com/$GITHUB_REPOSITORY.git"
          git fetch -q --no-tags --depth=1 origin "$SHA" && git checkout -q --detach FETCH_HEAD
          git fetch -q --no-tags --depth=1 origin refs/heads/release/website-embeds
          [ "$(git rev-parse FETCH_HEAD)" = "$SHA" ] || { echo "FAIL: branch moved since dispatch"; exit 1; }
          [ "$(git rev-parse HEAD:e2e)" = "$CF1_PIN_E2E_TREE" ] || { echo "FAIL: e2e tree differs from pin"; exit 1; }
          [ "$(sha256sum package-lock.json | cut -d' ' -f1)" = "$CF1_PIN_PACKAGE_LOCK_SHA256" ] || { echo "FAIL: lockfile differs"; exit 1; }
          [ "$(sha256sum scripts/qa/cf1-stripe-relay.ts | cut -d' ' -f1)" = "$CF1_PIN_RELAY_SHA256" ] || { echo "FAIL: relay differs"; exit 1; }

      - name: Install (npm ci, no key in the environment of this step)
        run: |
          # TODO pin actions/setup-node by SHA, node 20, npm cache
          npm ci

      - name: Start LOCAL Supabase and apply all migrations (public demo keys, no hosted credential)
        run: |
          # TODO pin supabase/setup-cli by SHA; supabase start; supabase db reset (all migrations)
          echo "TODO"

      - name: Key guard (first Stripe request; refuses non-TEST, wrong platform, inactive connected account)
        env:
          CF1_STRIPE_KEY: ${{ secrets.CF1_STRIPE_TEST_SECRET_KEY }}
        run: |
          # TODO scripts/qa/cf1-stripe-guard.ts: key shape sk_test_/rk_test_; GET /v1/account id == CF1_EXPECT_PLATFORM_ACCT and livemode=false;
          # GET /v1/accounts/$CF1_EXPECT_CONNECTED_ACCT charges_enabled and card_payments active; abort before any money-path call.
          echo "TODO"

      - name: Build and start the app (local), start the event relay, run Playwright
        env:
          STRIPE_SECRET_KEY: ${{ secrets.CF1_STRIPE_TEST_SECRET_KEY }}
          E2E_STRIPE_TEST_SECRET_KEY: ${{ secrets.CF1_STRIPE_TEST_SECRET_KEY }}
          E2E_STRIPE_TEST_CONNECTED_ACCOUNT: acct_1UZibNRCFiaIzL1V
          NEXT_PUBLIC_COMPETITION_REGISTRATION_ENABLED: "true"
          E2E_COMPETITION_REGISTRATION_ENABLED: "true"
          E2E_DESK_BALANCE_FIX: "true"   # TODO confirm CI-B desk-balance fix is on the dispatched commit
          E2E_BASE_URL: http://localhost:3000
        run: |
          # TODO: NODE_OPTIONS heap 6 GB; next build && next start (not next dev); generate STRIPE_CONNECT_WEBHOOK_SECRET/STRIPE_WEBHOOK_SECRET per run (openssl rand);
          # start scripts/qa/cf1-stripe-relay.ts (events.list on the connected account -> signed POST /api/payments/webhook; replay mode for duplicate/out-of-order tests; call cap CF1_STRIPE_CALL_CAP);
          # npx playwright test e2e/tests/competition-full-event.spec.ts e2e/tests/competition-stripe-failure-settlement.spec.ts --workers=1 (JSON reporter to a path OUTSIDE the checkout)
          echo "TODO"

      - name: Encrypt evidence to the engineering evidence key; upload ciphertext only (3-day retention)
        if: always()
        run: |
          # TODO reuse scripts/qa/d24-gh-proof/encrypt-cli.ts; public log gets only pass/fail counts and masked ids
          echo "TODO"
