SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=
APP_URL=

# Mux Video (server-only)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
# Store either the PEM value directly or its base64 encoding.
MUX_SIGNING_PRIVATE_KEY=
MUX_SIGNING_PRIVATE_KEY_BASE64=
MUX_WEBHOOK_SECRET=

# Production Synthetic Testing harness (server-only; FlowOps-governed, see
# C:\Dev\flowops quality/PRODUCTION-SYNTHETIC-TESTING.md). Every value below
# must point at the dedicated synthetic tenant/identities, never a real
# customer studio or account. Do not fill these in until that tenant and
# those restricted identities have been provisioned and approved -- the
# harness fails closed (refuses to run) if any required value is missing,
# so leaving these blank is the safe default.
SYNTHETIC_STUDIO_ID=
SYNTHETIC_OWNER_EMAIL=
SYNTHETIC_OWNER_PASSWORD=
SYNTHETIC_ORGANIZER_EMAIL=
SYNTHETIC_ORGANIZER_PASSWORD=
SYNTHETIC_STUDENT_EMAIL=
SYNTHETIC_STUDENT_PASSWORD=
SYNTHETIC_STUDENT_CLIENT_ID=
# Pre-provisioned reusable event fixture for SYN-EVENT-001 (an "explicitly
# tagged synthetic fixture" per the safety requirements, not created/torn
# down per run).
SYNTHETIC_EVENT_ID=
SYNTHETIC_EVENT_TICKET_TYPE_ID=
# Optional overrides; deployment SHA/version/environment are auto-detected
# from Vercel's own env vars when running on Vercel.
SYNTHETIC_DEPLOYMENT_SHA=
SYNTHETIC_DEPLOYMENT_VERSION=
SYNTHETIC_ENVIRONMENT=
