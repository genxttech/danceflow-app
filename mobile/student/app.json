{
  "expo": {
    "name": "DanceFlow",
    "slug": "danceflow-student",
    "scheme": "danceflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idanceflow.student",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DanceFlow uses your location to find nearby studios and events.",
        "NSUserNotificationsUsageDescription": "DanceFlow sends reminders for lessons, tickets, events, and saved studio updates when you enable notifications.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": false
    },
    "android": {
      "package": "com.idanceflow.student",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E1028",
        "foregroundImage": "./assets/danceflow-adaptive-foreground-symbol.png",
        "monochromeImage": "./assets/danceflow-adaptive-monochrome-symbol.png"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "122aaca5-d8eb-4ad9-84bc-f05c0e3bb8d1"
      },
      "router": {}
    },
    "icon": "./assets/danceflow-app-icon-1024.png",
    "splash": {
      "image": "./assets/danceflow-logo-primary.png",
      "resizeMode": "contain",
      "backgroundColor": "#180C1B"
    },
    "description": "DanceFlow helps dancers discover studios and events, keep tickets handy, view their schedule, track their learning, and get support from LUMI.",
    "privacy": "unlisted",
    "notification": {
      "icon": "./assets/danceflow-notification-symbol.png",
      "color": "#5B145E",
      "iosDisplayInForeground": true
    },
    "owner": "idanceflow"
  }
}
